// Per-frame Gaussian preprocessing: project to 2D, eval SH, compute tile AABB.

#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

layout (std430, set = 0, binding = 0) readonly buffer Vertices {
    Vertex vertices[];
};

layout (std430, set = 0, binding = 1) readonly buffer Cov3Ds {
    float cov3ds[];
};

layout (std140, set = 1, binding = 0) uniform Params {
    vec4 camera_position;
    mat4 proj_mat;
    mat4 view_mat;
    uint width;
    uint height;
    float tan_fovx;
    float tan_fovy;
    float clip_far;        // view-space far cull distance; 0 = disabled
    float clip_fade_frac;  // soft NEAR-clip band as a fraction of clip_near; 0 = hard cut (far is always hard)
    float clip_near;       // view-space near cull distance; 0 = disabled
};

layout (std430, set = 1, binding = 1) writeonly buffer VertexAttributes {
    VertexAttribute attr[];
};

layout (std430, set = 1, binding = 2) writeonly buffer NumTilesOverlap {
    uint tiles_overlap[];
};

// Pre-cull silhouette coverage (#112, XR_DXR_depth_budget v4). One texel per
// ~16x16 render pixels; the host clears it as part of its readback, so it
// accumulates the union over every view drawn since the last read. Always
// bound (a scene-lifetime 8-9 KB image) — armed by the push constant below,
// so an unarmed session pays one uniform branch per gaussian and nothing else.
layout (set = 1, binding = 3, r8ui) uniform writeonly uimage2D coverage_img;

layout (push_constant) uniform CoveragePush {
    uint coverage_on;   // 0 = skip the scatter entirely
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

mat3 get_projection_jacobian_approx(vec3 t) {
    float limx = 1.3 * tan_fovx;
    float limy = 1.3 * tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    t.x = min(limx, max(-limx, txtz)) * t.z;
    t.y = min(limy, max(-limy, tytz)) * t.z;

    float focal_x = width / (2 * tan_fovx);
    float focal_y = height / (2 * tan_fovy);

    return mat3(
        focal_x / t.z, 0, -(focal_x * t.x) / (t.z * t.z),
        0, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z),
        0, 0, 0
    );
}

mat2 compute_cov2d(vec3 cam) {
    uint index = gl_GlobalInvocationID.x;
    mat3 J = get_projection_jacobian_approx(cam);
    mat3 W = transpose(mat3(view_mat));
    mat3 Sigma = mat3(
        cov3ds[index * 6], cov3ds[index * 6 + 1], cov3ds[index * 6 + 2],
        cov3ds[index * 6 + 1], cov3ds[index * 6 + 3], cov3ds[index * 6 + 4],
        cov3ds[index * 6 + 2], cov3ds[index * 6 + 4], cov3ds[index * 6 + 5]
    );
    mat3 T = W * J;
    mat3 cov2d = transpose(T) * Sigma * T;
    cov2d[0][0] += 0.3f;
    cov2d[1][1] += 0.3f;
    // Vulkan Y-down raster flip (W7, #396): the splat center is written with
    // pixel.y = ndc2Pix(-ndc.y) below, so the 2D ellipse must be reflected
    // vertically to match — negate the xy off-diagonal. det (hence radius) and
    // eigenvalues are unchanged; only the ellipse orientation reflects. Doing
    // it here (not via a view-matrix reflection) keeps mouse pitch correct.
    cov2d[0][1] = -cov2d[0][1];
    cov2d[1][0] = -cov2d[1][0];
    return mat2(cov2d);
}

vec3 get_sh_vec3(uint ind) {
    uint index = gl_GlobalInvocationID.x;
    return vec3(vertices[index].sh[ind * 3], vertices[index].sh[ind * 3 + 1], vertices[index].sh[ind * 3 + 2]);
}

vec3 compute_sh() {
    uint index = gl_GlobalInvocationID.x;

    vec3 ray_direction = vertices[index].position.xyz - camera_position.xyz;
    ray_direction /= length(ray_direction);
    float x = ray_direction.x, y = ray_direction.y, z = ray_direction.z;

    vec3 c = SH_C0 * get_sh_vec3(0);

    c -= SH_C1 * get_sh_vec3(1) * y;
    c += SH_C1 * get_sh_vec3(2) * z;
    c -= SH_C1 * get_sh_vec3(3) * x;

    c += SH_C2[0] * get_sh_vec3(4) * x * y;
    c += SH_C2[1] * get_sh_vec3(5) * y * z;
    c += SH_C2[2] * get_sh_vec3(6) * (2.0 * z * z - x * x - y * y);
    c += SH_C2[3] * get_sh_vec3(7) * z * x;
    c += SH_C2[4] * get_sh_vec3(8) * (x * x - y * y);

    c += SH_C3[0] * get_sh_vec3(9) * (3.0 * x * x - y * y) * y;
    c += SH_C3[1] * get_sh_vec3(10) * x * y * z;
    c += SH_C3[2] * get_sh_vec3(11) * (4.0 * z * z - x * x - y * y) * y;
    c += SH_C3[3] * get_sh_vec3(12) * z * (2.0 * z * z - 3.0 * x * x - 3.0 * y * y);
    c += SH_C3[4] * get_sh_vec3(13) * x * (4.0 * z * z - x * x - y * y);
    c += SH_C3[5] * get_sh_vec3(14) * (x * x - y * y) * z;
    c += SH_C3[6] * get_sh_vec3(15) * x * (x * x - 3.0 * y * y);

    c += 0.5;
    c = max(c, vec3(0.0));

    return c;
}

float ndc2Pix(float v, int S) {
    return ((v + 1.0) * S - 1.0) * 0.5;
}

// Mark this gaussian's screen-space bounding box in the coverage image.
//
// #112 / XR_DXR_depth_budget v4: the app's content MASK must be the silhouette
// as it would render at UNRESTRICTED rear-depth budget. Deriving it from the
// rendered alpha instead makes the measured region a function of the clip the
// runtime published last frame — the runtime then measures the background it
// just caused to be revealed, and the rear clip oscillates. So this is called
// BEFORE the far cull below; nothing on this path may read clip_far.
//
// Cost: the raster is ~1 texel per 16x16 render tile, so the stores per
// gaussian are the same order as the tile-overlap count the pipeline already
// expands into (gaussian,tile) sort instances a few lines further down. A
// gaussian small enough to fall inside one texel costs exactly one store.
// uv/radii are in the SCALED render-pixel space (`width`/`height`), y already
// flipped by the caller, so the image is row-major TOP-LEFT origin — the
// convention dxr::ContentMaskFromCoverage expects.
void scatter_coverage(vec2 uv, float radii) {
    ivec2 cs = imageSize(coverage_img);
    vec2 s = vec2(float(cs.x) / float(width), float(cs.y) / float(height));
    vec2 f0 = (uv - vec2(radii)) * s;
    vec2 f1 = (uv + vec2(radii)) * s;
    // Entirely off the raster — clamping such a box would wrongly mark an edge
    // texel, which is a lie in the direction the runtime trusts.
    if (f1.x < 0.0 || f1.y < 0.0 || f0.x > float(cs.x) || f0.y > float(cs.y)) {
        return;
    }
    ivec2 lo = clamp(ivec2(floor(f0)), ivec2(0), cs - ivec2(1));
    ivec2 hi = clamp(ivec2(floor(f1)), ivec2(0), cs - ivec2(1));
    for (int y = lo.y; y <= hi.y; ++y) {
        for (int x = lo.x; x <= hi.x; ++x) {
            // Every writer stores the same value, so the races are benign and
            // no atomic is needed.
            imageStore(coverage_img, ivec2(x, y), uvec4(1u, 0u, 0u, 0u));
        }
    }
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= vertices.length()) {
        return;
    }

    ivec2 tile_shape = ivec2((width + TILE_WIDTH - 1) / TILE_WIDTH, (height + TILE_HEIGHT - 1) / TILE_HEIGHT);

    attr[index].color_radii.w = 0.0;
    tiles_overlap[index] = 0;

    vec4 p_hom = proj_mat * vertices[index].position;
    float p_w = 1.0f / p_hom.w;
    vec3 ndc = vec3(p_hom.xyz * p_w);

    vec4 p_view = view_mat * vertices[index].position;
    if (p_view.z <= 0.2f) {
        return;
    }

    // View-space near/far clip. This splat rasterizer does NOT test against
    // the projection-matrix near/far planes (only ndc.xy + p_view.z are used
    // downstream), so geometric clipping is done here as explicit p_view.z culls.
    // clip_near/clip_far are the per-eye view-space planes (ez - near_offset /
    // ez + far_offset).
    //   near: SOFT — clip_fade_frac > 0 ramps opacity 0->1 over
    //         [clip_near, clip_near*(1+frac)] so splat centers crossing the
    //         near plane fade rather than pop. frac = 0 restores a hard cut.
    //   far:  HARD — splats past clip_far are culled outright, no fade band
    //         (intentional: the far plane sits at the ZDP in foreground mode
    //         and a fade there is unwanted).
    // Either plane = 0 disables that side.
    //
    // #112: the FAR cull now sits further down, after the screen ellipse and
    // the coverage scatter. Nothing about the rendered image changes — every
    // test between here and there is a plain `return`, so the surviving set is
    // identical, and all attr[] writes moved below the last cull — but the
    // coverage image is now written on the far-culled path too, which is the
    // whole point (see scatter_coverage).
    float opacity_scale = 1.0f;
    if (clip_near > 0.0f) {
        if (p_view.z < clip_near) {
            return;
        }
        if (clip_fade_frac > 0.0f) {
            float near_fade_end = clip_near * (1.0f + clip_fade_frac);
            opacity_scale *= smoothstep(clip_near, near_fade_end, p_view.z);
        }
    }
    if (opacity_scale <= 1.0f / 255.0f) {
        return;
    }

    mat2 cov2d = compute_cov2d(p_view.xyz);
    float det = determinant(cov2d);
    if (det <= 0.0) {
        return;
    }
    mat2 conic = inverse(cov2d);

    float mid = 0.5 * (cov2d[0][0] + cov2d[1][1]);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1, mid * mid - det));
    float lambda = max(lambda1, lambda2);
    float radii = ceil(3.0 * sqrt(lambda));

    // Subpixel cull — gaussians smaller than 1 px contribute nothing visible
    // and waste sort capacity. (Capping the radius higher would create square
    // cutoff artifacts because cov2d would be unchanged; floater control is
    // done at load time via filterFloaters() instead.)
    if (radii < 1.0) {
        return;
    }

    // Vulkan Y-down raster flip (W7, #396): negate ndc.y when mapping to the
    // pixel center so a +Y-up world renders upright without reflecting the view
    // matrix (which would invert mouse pitch). Paired with the cov2d off-diagonal
    // negation in compute_cov2d so the ellipse reflects with the center.
    vec2 uv = vec2(ndc2Pix(ndc.x, int(width)), ndc2Pix(-ndc.y, int(height)));

    // ── Unrestricted-budget silhouette (#112) — BEFORE the far cull ──────
    if (coverage_on != 0u) {
        scatter_coverage(uv, radii);
    }

    // Far clip — HARD cut, see the near/far note above. Everything below this
    // line shapes what is actually RENDERED; the coverage image is already
    // written, so the mask no longer depends on clip_far.
    if (clip_far > 0.0f) {
        if (p_view.z > clip_far) {
            return;
        }
    }

    uvec4 bounding_box = uvec4(
        uint(clamp(int((uv.x - radii) / TILE_WIDTH), 0, tile_shape.x)),
        uint(clamp(int((uv.y - radii) / TILE_HEIGHT), 0, tile_shape.y)),
        uint(clamp(int((uv.x + radii + TILE_WIDTH - 1) / TILE_WIDTH), 0, tile_shape.x)),
        uint(clamp(int((uv.y + radii + TILE_HEIGHT - 1) / TILE_HEIGHT), 0, tile_shape.y))
    );

    uint num_tiles_overlap = (bounding_box.z - bounding_box.x) * (bounding_box.w - bounding_box.y);
    if (num_tiles_overlap == 0) {
        return;
    }
    attr[index].conic_opacity.xyz = vec3(conic[0][0], conic[0][1], conic[1][1]);
    attr[index].conic_opacity.w = vertices[index].scale_opacity.w * opacity_scale;
    attr[index].aabb = bounding_box;
    tiles_overlap[index] = num_tiles_overlap;
    attr[index].depth = p_view.z;
    attr[index].color_radii.w = radii;
    attr[index].color_radii.xyz = compute_sh();
    attr[index].uv = uv;
    attr[index].magic = MAGIC;
}
