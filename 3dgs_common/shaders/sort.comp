// Ported from VkRadixSort by Mirco Werner (https://github.com/MircoWerner/VkRadixSort)
// via 3DGS.cpp. Radix sort scatter pass.

#version 460
#extension GL_GOOGLE_include_directive : enable

// 32-bit keys + 32-bit flag words (Adreno has no shaderInt64). The radix sort
// is identical; BITS=32 packs the WORKGROUP_SIZE per-bin flags into 32-bit
// words (no uint64_t / flags1+flags2 CAS split needed).
#define WORKGROUP_SIZE 256
#define RADIX_SORT_BINS 256U
#define BITS 32
#define key_t uint

// The cross-bin scan below runs in SHARED MEMORY, not with subgroup ops.
//
// It used to be subgroupAdd / subgroupExclusiveAdd per subgroup, then a second
// subgroupExclusiveAdd over the per-subgroup sums broadcast from lane
// gl_SubgroupID. That form is only correct when the driver lays the 256
// invocations out as contiguous subgroups of exactly the reported size, and on
// the Snapdragon X2 / Adreno X2-45 Windows Vulkan driver (1.4.295) it is not:
// it reports subgroupSize 64 (min = max = 64) and the scatter came out
// mis-sorted (19k-30k descending keys out of 408k, with SUBGROUP_SIZE
// specialized to 64 or to 128). Mis-sorted keys give tile_boundary.comp
// inverted ranges (end < start), render.comp then loops ~2^32 fragments, the
// GPU hangs for ~2.6 s, and the device is lost — every later vkQueueSubmit on
// that VkDevice, including the DisplayXR runtime's compositor submits on the
// shared queue, fails with -3 and the window stays empty.
//
// A 256-entry Hillis-Steele scan costs 8 steps x 2 barriers per workgroup per
// pass, negligible next to the scatter loop, and has no subgroup-size,
// subgroup-layout or varying-size preconditions at all.
//
// SUBGROUP_SIZE is no longer read. It stays declared only so the host's
// specialization map (constant_id 0) keeps matching the module.
layout (constant_id = 0) const uint SUBGROUP_SIZE = 32;

layout (local_size_x = WORKGROUP_SIZE) in;

layout (push_constant, std430) uniform PushConstants {
    uint g_num_elements;
    uint g_shift;
    uint g_num_workgroups;
    uint g_num_blocks_per_workgroup;
};

layout (std430, set = 0, binding = 0) buffer elements_in {
    key_t g_elements_in[];
};

layout (std430, set = 0, binding = 1) buffer elements_out {
    key_t g_elements_out[];
};

layout (std430, set = 0, binding = 2) buffer payload_in {
    uint g_payload_in[];
};

layout (std430, set = 0, binding = 3) buffer payload_out {
    uint g_payload_out[];
};

layout (std430, set = 0, binding = 4) buffer histograms {
    uint g_histograms[];
};

// Bin totals, scanned in place (inclusive) at the top of main().
shared uint[RADIX_SORT_BINS] scan;
shared uint[RADIX_SORT_BINS] global_offsets;

// 32-bit flag words: WORKGROUP_SIZE thread flags packed into 32-bit ints.
struct BinFlags {
    uint flags[WORKGROUP_SIZE / BITS];
};
shared BinFlags[RADIX_SORT_BINS] bin_flags;

void main() {
    uint gID = gl_GlobalInvocationID.x;
    uint lID = gl_LocalInvocationID.x;
    uint wID = gl_WorkGroupID.x;
    uint local_histogram = 0;
    uint histogram_count = 0;

    if (lID < RADIX_SORT_BINS) {
        uint count = 0;
        for (uint j = 0; j < g_num_workgroups; j++) {
            const uint t = g_histograms[RADIX_SORT_BINS * j + lID];
            local_histogram = (j == wID) ? count : local_histogram;
            count += t;
        }
        histogram_count = count;
        scan[lID] = count;
    }
    barrier();

    // Inclusive Hillis-Steele scan of the 256 bin totals in shared memory.
    for (uint offset = 1u; offset < RADIX_SORT_BINS; offset <<= 1u) {
        uint v = 0u;
        if (lID < RADIX_SORT_BINS && lID >= offset) {
            v = scan[lID - offset];
        }
        barrier();
        if (lID < RADIX_SORT_BINS) {
            scan[lID] += v;
        }
        barrier();
    }

    if (lID < RADIX_SORT_BINS) {
        // exclusive prefix of the bin totals + this workgroup's offset in its bin
        global_offsets[lID] = (scan[lID] - histogram_count) + local_histogram;
    }

    const uint flags_bin = lID / BITS;
    const uint flags_bit = 1u << (lID % BITS);

    for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {
        uint elementId = wID * g_num_blocks_per_workgroup * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;

        if (lID < RADIX_SORT_BINS) {
            for (int i = 0; i < WORKGROUP_SIZE / BITS; i++) {
                bin_flags[lID].flags[i] = 0U;
            }
        }
        barrier();

        key_t element_in = 0;
        uint payload_in = 0;
        uint binID = 0;
        uint binOffset = 0;
        if (elementId < g_num_elements) {
            element_in = g_elements_in[elementId];
            payload_in = g_payload_in[elementId];
            binID = uint(element_in >> g_shift) & uint(RADIX_SORT_BINS - 1);
            binOffset = global_offsets[binID];
            atomicAdd(bin_flags[binID].flags[flags_bin], flags_bit);
        }
        barrier();

        if (elementId < g_num_elements) {
            uint prefix = 0;
            uint count = 0;
            for (uint i = 0; i < WORKGROUP_SIZE / BITS; i++) {
                const uint flag = bin_flags[binID].flags[i];
                const uint full_count = bitCount(flag);
                const uint partial_count = bitCount(flag & (flags_bit - 1u));
                prefix += (i < flags_bin) ? full_count : 0U;
                prefix += (i == flags_bin) ? partial_count : 0U;
                count += full_count;
            }
            g_elements_out[binOffset + prefix] = element_in;
            g_payload_out[binOffset + prefix] = payload_in;
            if (prefix == count - 1) {
                atomicAdd(global_offsets[binID], count);
            }
        }

        barrier();
    }
}
