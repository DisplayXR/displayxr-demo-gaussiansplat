//
// Adreno/TBDR-native per-gaussian preprocess (graphics-pipeline splat path).
//
// This is preprocess.comp with the per-tile machinery removed: the desktop
// compute compositor needed each gaussian's tile-AABB + tile-overlap count to
// expand into ~1.4M per-tile fragments for a global fragment sort. The Adreno
// path draws one instanced quad per gaussian and lets the hardware ROP blend
// in tile memory, so it only needs the per-gaussian screen ellipse — center
// uv, conic, colour, depth, pixel radius. No aabb, no tiles_overlap buffer.
//
// Projection / 2D covariance / SH / clip math is byte-identical to
// preprocess.comp so the visual result matches the desktop renderer.

#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

layout (std430, set = 0, binding = 0) readonly buffer Vertices {
    Vertex vertices[];
};

layout (std430, set = 0, binding = 1) readonly buffer Cov3Ds {
    float cov3ds[];
};

layout (std140, set = 1, binding = 0) uniform Params {
    vec4 camera_position;
    mat4 proj_mat;
    mat4 view_mat;
    uint width;
    uint height;
    float tan_fovx;
    float tan_fovy;
    float clip_far;        // view-space far cull distance; 0 = disabled
    float clip_fade_frac;  // soft NEAR-clip band as a fraction of clip_near; 0 = hard cut (far always hard)
    float clip_near;       // view-space near cull distance; 0 = disabled
};

layout (std430, set = 1, binding = 1) writeonly buffer VertexAttributes {
    VertexAttribute attr[];
};

// Pre-cull silhouette coverage (#112, XR_DXR_depth_budget v4) — mirror of
// preprocess.comp's binding 3 (this set has no tiles_overlap buffer, so the
// next free binding here is 2). One texel per ~16x16 render pixels; the host
// clears it as part of its readback, so it accumulates the union over every
// view drawn since the last read. Always bound; armed by the push constant.
layout (set = 1, binding = 2, r8ui) uniform writeonly uimage2D coverage_img;

layout (push_constant) uniform PreprocPush {
    uint coverage_on;     // 0 = skip the #112 silhouette scatter entirely
    uint flags;           // see FLAG_* below (gsperf::kFlag* on the host)
    float max_radius_px;  // quad extent cap in render px; 0 = uncapped
};

// Opacity-aware quad extent. The quad only has to cover the pixels the
// FRAGMENT shader would keep, and splat.frag discards at alpha < 1/255 with
// alpha = opacity * exp(power), power = -q/2 for the conic form q. So the
// last surviving pixel sits at q = 2*ln(255*opacity), and the ellipse
// {q <= c} reaches at most sqrt(c*lambda) along any direction. Clamped to
// the historical 3 sigma so this can only ever SHRINK the quad — every
// fragment it removes is one the FS was already discarding, which is what
// makes it bit-exact rather than an approximation.
#define FLAG_OPACITY_EXTENT 1u
// Drop gaussians whose effective opacity cannot reach 1/255 at ANY pixel
// (exp(power) <= 1 everywhere), so they can never pass the FS test.
#define FLAG_INVISIBLE_CULL 2u

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

mat3 get_projection_jacobian_approx(vec3 t) {
    float limx = 1.3 * tan_fovx;
    float limy = 1.3 * tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    t.x = min(limx, max(-limx, txtz)) * t.z;
    t.y = min(limy, max(-limy, tytz)) * t.z;

    float focal_x = width / (2 * tan_fovx);
    float focal_y = height / (2 * tan_fovy);

    return mat3(
        focal_x / t.z, 0, -(focal_x * t.x) / (t.z * t.z),
        0, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z),
        0, 0, 0
    );
}

mat2 compute_cov2d(vec3 cam) {
    uint index = gl_GlobalInvocationID.x;
    mat3 J = get_projection_jacobian_approx(cam);
    mat3 W = transpose(mat3(view_mat));
    mat3 Sigma = mat3(
        cov3ds[index * 6], cov3ds[index * 6 + 1], cov3ds[index * 6 + 2],
        cov3ds[index * 6 + 1], cov3ds[index * 6 + 3], cov3ds[index * 6 + 4],
        cov3ds[index * 6 + 2], cov3ds[index * 6 + 4], cov3ds[index * 6 + 5]
    );
    mat3 T = W * J;
    mat3 cov2d = transpose(T) * Sigma * T;
    cov2d[0][0] += 0.3f;
    cov2d[1][1] += 0.3f;
    // Vulkan Y-down raster flip (W7, #396): the center is written with
    // pixel.y = ndc2Pix(-ndc.y), so the 2D ellipse must reflect vertically —
    // negate the xy off-diagonal. det / eigenvalues unchanged.
    cov2d[0][1] = -cov2d[0][1];
    cov2d[1][0] = -cov2d[1][0];
    return mat2(cov2d);
}

vec3 get_sh_vec3(uint ind) {
    uint index = gl_GlobalInvocationID.x;
    return vec3(vertices[index].sh[ind * 3], vertices[index].sh[ind * 3 + 1], vertices[index].sh[ind * 3 + 2]);
}

vec3 compute_sh() {
    uint index = gl_GlobalInvocationID.x;

    vec3 ray_direction = vertices[index].position.xyz - camera_position.xyz;
    ray_direction /= length(ray_direction);
    float x = ray_direction.x, y = ray_direction.y, z = ray_direction.z;

    vec3 c = SH_C0 * get_sh_vec3(0);

    c -= SH_C1 * get_sh_vec3(1) * y;
    c += SH_C1 * get_sh_vec3(2) * z;
    c -= SH_C1 * get_sh_vec3(3) * x;

    c += SH_C2[0] * get_sh_vec3(4) * x * y;
    c += SH_C2[1] * get_sh_vec3(5) * y * z;
    c += SH_C2[2] * get_sh_vec3(6) * (2.0 * z * z - x * x - y * y);
    c += SH_C2[3] * get_sh_vec3(7) * z * x;
    c += SH_C2[4] * get_sh_vec3(8) * (x * x - y * y);

    c += SH_C3[0] * get_sh_vec3(9) * (3.0 * x * x - y * y) * y;
    c += SH_C3[1] * get_sh_vec3(10) * x * y * z;
    c += SH_C3[2] * get_sh_vec3(11) * (4.0 * z * z - x * x - y * y) * y;
    c += SH_C3[3] * get_sh_vec3(12) * z * (2.0 * z * z - 3.0 * x * x - 3.0 * y * y);
    c += SH_C3[4] * get_sh_vec3(13) * x * (4.0 * z * z - x * x - y * y);
    c += SH_C3[5] * get_sh_vec3(14) * (x * x - y * y) * z;
    c += SH_C3[6] * get_sh_vec3(15) * x * (x * x - 3.0 * y * y);

    c += 0.5;
    c = max(c, vec3(0.0));

    return c;
}

float ndc2Pix(float v, int S) {
    return ((v + 1.0) * S - 1.0) * 0.5;
}

// Mark this gaussian's screen-space bounding box in the coverage image.
//
// #112 / XR_DXR_depth_budget v4: the app's content MASK must be the silhouette
// as it would render at UNRESTRICTED rear-depth budget. Deriving it from the
// rendered alpha instead makes the measured region a function of the clip the
// runtime published last frame — the runtime then measures the background it
// just caused to be revealed, and the rear clip oscillates. So this is called
// BEFORE the far cull below; nothing on this path may read clip_far.
//
// Cost: the raster is ~1 texel per 16x16 render pixels, i.e. 1/256th of the
// area the gaussian's own instanced quad already rasterises and blends in
// tile memory. A gaussian small enough to fall inside one texel — which is
// most of them — costs exactly one store.
// uv/radii are in the SCALED render-pixel space (`width`/`height`), y already
// flipped by the caller, so the image is row-major TOP-LEFT origin — the
// convention dxr::ContentMaskFromCoverage expects.
void scatter_coverage(vec2 uv, float radii) {
    ivec2 cs = imageSize(coverage_img);
    vec2 s = vec2(float(cs.x) / float(width), float(cs.y) / float(height));
    vec2 f0 = (uv - vec2(radii)) * s;
    vec2 f1 = (uv + vec2(radii)) * s;
    // Entirely off the raster — clamping such a box would wrongly mark an edge
    // texel, which is a lie in the direction the runtime trusts.
    if (f1.x < 0.0 || f1.y < 0.0 || f0.x > float(cs.x) || f0.y > float(cs.y)) {
        return;
    }
    ivec2 lo = clamp(ivec2(floor(f0)), ivec2(0), cs - ivec2(1));
    ivec2 hi = clamp(ivec2(floor(f1)), ivec2(0), cs - ivec2(1));
    for (int y = lo.y; y <= hi.y; ++y) {
        for (int x = lo.x; x <= hi.x; ++x) {
            // Every writer stores the same value, so the races are benign and
            // no atomic is needed.
            imageStore(coverage_img, ivec2(x, y), uvec4(1u, 0u, 0u, 0u));
        }
    }
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= vertices.length()) {
        return;
    }

    // Default: culled. radii 0 + cleared magic make splat.vert collapse this
    // gaussian's quad to a degenerate point (covers no fragments).
    attr[index].color_radii.w = 0.0;
    attr[index].magic = 0u;
    attr[index].depth = 0.0;

    vec4 p_view = view_mat * vertices[index].position;
    if (p_view.z <= 0.2f) {
        return;
    }

    // View-space near/far clip (the rasterizer ignores ndc.z, so geometric
    // near/far clipping is done here as explicit p_view.z culls — see
    // preprocess.comp for the full rationale). near is SOFT (opacity ramp over
    // [clip_near, clip_near*(1+frac)]); far is HARD.
    //
    // #112: the FAR cull sits below the coverage scatter, not here — see
    // preprocess.comp for the full rationale. Every test in between is a plain
    // `return` and every attr[] write is past the last cull, so the rendered
    // result is unchanged.
    float opacity_scale = 1.0f;
    if (clip_near > 0.0f) {
        if (p_view.z < clip_near) {
            return;
        }
        if (clip_fade_frac > 0.0f) {
            float near_fade_end = clip_near * (1.0f + clip_fade_frac);
            opacity_scale *= smoothstep(clip_near, near_fade_end, p_view.z);
        }
    }
    if (opacity_scale <= 1.0f / 255.0f) {
        return;
    }

    // Effective opacity — exactly what splat.frag receives as v_opacity.
    float opacity = vertices[index].scale_opacity.w * opacity_scale;

    // Exactly-invisible cull. alpha = min(0.99, opacity * exp(power)) and
    // power <= 0 for a positive-definite conic, so alpha <= opacity at every
    // pixel. opacity < 1/255 therefore means alpha < 1/255 everywhere and the
    // FS discards every fragment of this quad. STRICT '<': at opacity exactly
    // 1/255 the centre pixel has alpha == 1/255, which is NOT < 1/255 and does
    // render — so '<=' here would drop a visible splat.
    if ((flags & FLAG_INVISIBLE_CULL) != 0u && opacity < 1.0f / 255.0f) {
        return;
    }

    vec4 p_hom = proj_mat * vertices[index].position;
    float p_w = 1.0f / p_hom.w;
    vec3 ndc = vec3(p_hom.xyz * p_w);

    mat2 cov2d = compute_cov2d(p_view.xyz);
    float det = determinant(cov2d);
    if (det <= 0.0) {
        return;
    }
    mat2 conic = inverse(cov2d);

    float mid = 0.5 * (cov2d[0][0] + cov2d[1][1]);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1, mid * mid - det));
    float lambda = max(lambda1, lambda2);
    float extent = 3.0 * sqrt(lambda);
    if ((flags & FLAG_OPACITY_EXTENT) != 0u) {
        // ln(255*opacity) > 0 is guaranteed here: opacity >= 1/255 either
        // because FLAG_INVISIBLE_CULL rejected the rest, or — with that flag
        // off — because max() floors the argument at 1 so the extent collapses
        // to 0 and the radii<1 cull below removes the quad. Either way the
        // gaussian that reaches min() has a real, non-negative radius.
        extent = min(extent, sqrt(2.0 * lambda * log(max(255.0 * opacity, 1.0))));
    }
    // Lossy, opt-in: clamp the on-screen footprint of the sky-sized mega-splats
    // that dominate overdraw. Unlike the two levers above this DOES remove
    // fragments the FS would have kept, so it is off by default.
    if (max_radius_px > 0.0) {
        extent = min(extent, max_radius_px);
    }
    float radii = ceil(extent);

    // Subpixel cull — gaussians under 1 px contribute nothing visible.
    if (radii < 1.0) {
        return;
    }

    // Vulkan Y-down raster flip (W7, #396) — negate ndc.y mapping to pixel.
    vec2 uv = vec2(ndc2Pix(ndc.x, int(width)), ndc2Pix(-ndc.y, int(height)));

    // ── Unrestricted-budget silhouette (#112) — BEFORE the far cull ──────
    if (coverage_on != 0u) {
        scatter_coverage(uv, radii);
    }

    // Far clip — HARD cut. Everything below shapes what is actually RENDERED;
    // the coverage image is already written, so the mask cannot depend on it.
    if (clip_far > 0.0f) {
        if (p_view.z > clip_far) {
            return;
        }
    }

    attr[index].conic_opacity.xyz = vec3(conic[0][0], conic[0][1], conic[1][1]);
    attr[index].conic_opacity.w = opacity;
    attr[index].color_radii.xyz = compute_sh();
    attr[index].color_radii.w = radii;
    attr[index].uv = uv;
    attr[index].depth = p_view.z;
    attr[index].magic = MAGIC;
}
